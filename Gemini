<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>小西家</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: #f7f7f5;
      color: #333333;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }
    .container {
      background: #ffffff;
      padding: 40px 30px;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      text-align: center;
      max-width: 400px;
      width: 100%;
    }
    h1 {
      font-size: 28px;
      margin-bottom: 24px;
      font-weight: 700;
      letter-spacing: 2px;
    }
    p {
      color: #666666;
      font-size: 15px;
      margin-bottom: 30px;
    }
    .login-btn {
      background-color: #1a62a6;
      color: #ffffff;
      border: none;
      padding: 14px 24px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: bold;
      width: 100%;
      cursor: pointer;
      transition: background-color 0.2s ease, transform 0.1s ease;
    }
    .login-btn:active {
      transform: scale(0.98);
    }
  </style>
</head>
<body>

  <main class="container">
    <h1>小西家</h1>
    <p>ファミリーアプリへようこそ</p>
    <button class="login-btn" onclick="alert('Googleログインを準備中です')">Googleでログイン</button>
  </main>

</body>
</html>
